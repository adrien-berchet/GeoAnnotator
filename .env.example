# GeoAnnotator Environment Variables
# Copy this file to .env and update values for your environment

# Django Settings
DEBUG=True
DJANGO_SECRET_KEY=dev-local-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Fernet Encryption Key (for email encryption)
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
FERNET_KEY=

# Database
POSTGRES_HOST=db
POSTGRES_DB=geoannotator
POSTGRES_USER=geoannotator
POSTGRES_PASSWORD=geoannotator_dev_password
POSTGRES_PORT=5432

# MinIO / S3
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# Frontend
VITE_API_URL=http://localhost:8000/api/v1

# Email Configuration
# Option 1: Console backend (prints to terminal) - Recommended for development
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@geoannotator.local

# Option 2: Gmail SMTP (uncomment to use - requires App Password from Google)
# Get App Password: https://myaccount.google.com/apppasswords
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-16-char-app-password-here
# DEFAULT_FROM_EMAIL=your-email@gmail.com

# Option 3: Custom SMTP server
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-password
# DEFAULT_FROM_EMAIL=noreply@geoannotator.com

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Storage Quotas
DEFAULT_STORAGE_LIMIT=2147483648
MAX_FILE_SIZE=1073741824

# Database Backups (requires S3-compatible storage)
# Automated weekly backups are created and uploaded to S3/MinIO
# Development: Use MinIO (configured in docker-compose.yml)
# Production: Use AWS S3 or S3-compatible service
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_REGION_NAME=eu-west-3
# AWS_S3_ENDPOINT_URL=http://localhost:9000  # For MinIO only (omit for AWS S3)

# Monitoring & Observability (Optional - for production error tracking)
# Backend Sentry Configuration
# Get your DSN from: https://sentry.io/ (free tier available)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Frontend Sentry Configuration
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
