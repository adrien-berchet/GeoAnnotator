/**
 * Annotation Form - Styles spécifiques
 * Utilise les classes communes définies dans styles/components.css
 * Ne contient que les styles vraiment spécifiques à ce composant
 */

.annotation-form {
  /* Les styles card, form-group, btn, etc. sont maintenant dans components.css */
}

/* Type Selector - spécifique à ce composant */
.annotation-type-selector {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-xl);
}

.type-button {
  padding: var(--spacing-md);
  border: 2px solid var(--color-border-primary);
  background: var(--color-bg-primary);
  border-radius: var(--radius-lg);
  cursor: pointer;
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-secondary);
  transition: all var(--transition-base);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-sm);
}

.type-button:hover {
  border-color: var(--color-primary);
  background: var(--color-info-bg);
}

.type-button.active {
  border-color: var(--color-primary);
  background: var(--color-primary);
  color: white;
}

/* File Input - spécifique */
.file-input {
  width: 100%;
  padding: var(--spacing-md);
  border: 2px dashed var(--color-border-secondary);
  border-radius: var(--radius-md);
  cursor: pointer;
  transition: border-color var(--transition-base);
  background: var(--color-bg-primary);
  color: var(--color-text-primary);
}

.file-input:hover {
  border-color: var(--color-primary);
}

.file-input:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.selected-file {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  margin-top: var(--spacing-md);
  padding: var(--spacing-md);
  background: var(--color-bg-secondary);
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border-primary);
}

.file-icon {
  font-size: var(--font-size-xl);
}

.file-name {
  flex: 1;
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
  font-weight: var(--font-weight-medium);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-size {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

.close-button {
  background: transparent;
  border: none;
  font-size: var(--font-size-xl);
  color: var(--color-text-muted);
  cursor: pointer;
  padding: 0;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
  transition: all var(--transition-base);
}

.close-button:hover {
  background: var(--color-bg-secondary);
  color: var(--color-text-primary);
}

/* Responsive */
@media (max-width: 768px) {
  .annotation-type-selector {
    grid-template-columns: repeat(2, 1fr);
  }
}
