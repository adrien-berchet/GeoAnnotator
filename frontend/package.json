    "axios": "^1.12.2",
    "hast": "^0.0.2",
    "leaflet": "^1.9.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.9.3",
    "rehype-sanitize": "^6.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
