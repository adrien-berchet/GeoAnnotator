{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run typecheck && npm run lint",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:components": "vitest run tests/components",
    "test:integration": "npm run test:integration:account && npm run test:integration:types && npm run test:integration:theme && npm run test:integration:annotations && npm run test:integration:map:search",
    "test:integration:account": "vitest run tests/integration/account-management.test.tsx",
    "test:integration:types": "vitest run src/__tests__/integration/type-management.integration.test.tsx",
    "test:integration:theme": "vitest run src/__tests__/integration/theme-persistence.integration.test.tsx",
    "test:integration:annotations": "vitest run src/__tests__/integration/AnnotationMarkdown.integration.test.tsx",
    "test:integration:map:search": "vitest run src/__tests__/integration/map-search.integration.test.tsx",
    "test:map": "vitest run tests/map",
    "test:all": "npm run test:components && npm run test:annotations && npm run test:integration && npm run test:map && npm run test:settings",
    "test:settings": "vitest run tests/settings",
    "test:annotations": "vitest run src/__tests__/components/annotations",
    "check:memory": "node scripts/check-memory.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sentry/react": "^10.26.0",
    "@tanstack/react-query": "^5.90.2",
    "@types/dompurify": "^3.0.5",
    "@types/leaflet.markercluster": "^1.5.6",
    "@uiw/react-md-editor": "^4.0.8",
    "axios": "^1.12.2",
    "dompurify": "^3.3.0",
    "hast": "^0.0.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.9.3",
    "rehype-sanitize": "^6.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
