[flake8]
max-line-length = 100
exclude =
    .git,
    __pycache__,
    */migrations/*,
    */settings/*,
    venv,
    .venv,
    env,
    build,
    dist
max-complexity = 10
ignore =
    E203,  # Whitespace before ':' (conflicts with black)
    W503,  # Line break before binary operator (conflicts with black)
per-file-ignores =
    __init__.py:F401
    */tests/*:F401,F811
