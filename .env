# GeoAnnotator Environment Variables - LOCAL DEVELOPMENT
# Copy this file to .env and update values for your environment

# Django Settings
DEBUG=True
SECRET_KEY=dev-local-secret-key-not-for-production-use-only-for-testing
ALLOWED_HOSTS=localhost,127.0.0.1,backend,geoannotator.onrender.com

# Database
DB_PASSWORD=geoannotator_dev_password

# MinIO / S3
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# Frontend
VITE_API_URL=http://localhost:8000/api/v1

# Email (for production, use SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Storage Quotas
DEFAULT_STORAGE_LIMIT_GB=2
MAX_FILE_SIZE_GB=1
